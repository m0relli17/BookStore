@{
    ViewBag.Title = "Home Page";
}

<!-- Hero Banner & Side Banner Section -->
<div class="row g-3 mb-4">
    <!-- Main Carousel Banner -->
    <div class="col-lg-8">
        <div id="mainBannerCarousel" class="carousel slide rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#mainBannerCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#mainBannerCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#mainBannerCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/images/banners/lich-2027.jpg" class="d-block w-100" alt="Lịch 2027">
                </div>
                <div class="carousel-item">
                    <img src="/images/banners/wimpy-kid-21.jpg" class="d-block w-100" alt="Wimpy Kid 21">
                </div>
                <div class="carousel-item">
                    <img src="/images/banners/foreign-books.jpg" class="d-block w-100" alt="Foreign Books">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>

    <!-- Side Banner Block -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100 p-3 bg-light rounded-3">
            <h5 class="fw-bold text-primary mb-3">Sách mới tháng này</h5>
            <div class="d-flex align-items-center justify-content-between">
                <img src="/images/books/toi-chon-chinh-minh.jpg" class="img-fluid rounded" style="max-height: 140px;" alt="Sách mới">
                <img src="/images/books/nhang-la-thu.jpg" class="img-fluid rounded" style="max-height: 140px;" alt="Sách mới">
            </div>
        </div>
    </div>
</div>

<!-- Category Icons Grid -->
<div class="row row-cols-3 row-cols-md-6 g-3 mb-4 text-center">
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-danger mb-2"><i class="bi bi-percent"></i></div>
            <div class="fw-bold small">KHUYẾN MÃI</div>
        </a>
    </div>
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-success mb-2"><i class="bi bi-tree"></i></div>
            <div class="fw-bold small">XMAS</div>
        </a>
    </div>
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-warning mb-2"><i class="bi bi-gift"></i></div>
            <div class="fw-bold small">QUÀ TẶNG</div>
        </a>
    </div>
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-info mb-2"><i class="bi bi-controller"></i></div>
            <div class="fw-bold small">ĐỒ CHƠI</div>
        </a>
    </div>
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-primary mb-2"><i class="bi bi-emoji-smile"></i></div>
            <div class="fw-bold small">THÚ BÔNG</div>
        </a>
    </div>
    <div class="col">
        <a href="#" class="text-decoration-none text-dark card h-100 border-0 shadow-sm p-3 hover-top">
            <div class="fs-1 text-dark mb-2"><i class="bi bi-collection"></i></div>
            <div class="fw-bold small">IP COLLECTIONS</div>
        </a>
    </div>
</div>

<!-- Promo Voucher Voucher Alert -->
<div class="alert alert-danger d-flex justify-content-between align-items-center rounded-3 mb-4 shadow-sm" role="alert">
    <div>
        <span class="badge bg-danger me-2">Mã Khuyến Mãi</span>
        <strong>Giảm ship 29k</strong> cho đơn hàng tối thiểu 400k
    </div>
    <button class="btn btn-outline-danger btn-sm rounded-pill">Sao chép mã</button>
</div>

<!-- Product Section: Manga / Truyện Tranh -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-uppercase m-0 border-start border-4 border-danger ps-2">Truyện Tranh - Manga</h4>
        <a href="#" class="text-danger text-decoration-none fw-bold small">Xem tất cả <i class="bi bi-chevron-right"></i></a>
    </div>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
        <!-- Loop items dynamically from Model in real app -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">New</span>
                <img src="/images/manga/khuc-hat-dem-thau.jpg" class="card-img-top p-2" alt="Khúc Hát Đêm Thâu - Tập 8">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h6 class="card-title text-truncate-2 small fw-bold">Khúc Hát Đêm Thâu - Tập 8</h6>
                    <div class="mt-2">
                        <div class="text-danger fw-bold">33.250 ₫ <span class="badge bg-danger-subtle text-danger ms-1">-5%</span></div>
                        <div class="text-muted text-decoration-line-through small">35.000 ₫</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">New</span>
                <img src="/images/manga/nisekoi-20.jpg" class="card-img-top p-2" alt="Nisekoi Tập 20">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h6 class="card-title text-truncate-2 small fw-bold">Nisekoi - Cặp Đôi Giả Tạo - Tập 20</h6>
                    <div class="mt-2">
                        <div class="text-danger fw-bold">38.000 ₫ <span class="badge bg-danger-subtle text-danger ms-1">-5%</span></div>
                        <div class="text-muted text-decoration-line-through small">40.000 ₫</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">New</span>
                <img src="/images/manga/dan-da-dan-7.jpg" class="card-img-top p-2" alt="Dan Da Dan Tập 7">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h6 class="card-title text-truncate-2 small fw-bold">Dan Da Dan - Tập 7</h6>
                    <div class="mt-2">
                        <div class="text-danger fw-bold">42.750 ₫ <span class="badge bg-danger-subtle text-danger ms-1">-5%</span></div>
                        <div class="text-muted text-decoration-line-through small">45.000 ₫</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">New</span>
                <img src="/images/manga/bluelock-nagi-3.jpg" class="card-img-top p-2" alt="Bluelock Episode Nagi Tập 3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h6 class="card-title text-truncate-2 small fw-bold">Bluelock - Episode Nagi - Tập 3</h6>
                    <div class="mt-2">
                        <div class="text-danger fw-bold">33.250 ₫ <span class="badge bg-danger-subtle text-danger ms-1">-5%</span></div>
                        <div class="text-muted text-decoration-line-through small">35.000 ₫</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">New</span>
                <img src="/images/manga/komi-36.jpg" class="card-img-top p-2" alt="Komi Nữ Thần Sợ Giao Tiếp Tập 36">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h6 class="card-title text-truncate-2 small fw-bold">Komi - Nữ Thần Sợ Giao Tiếp - Tập 36</h6>
                    <div class="mt-2">
                        <div class="text-danger fw-bold">28.500 ₫ <span class="badge bg-danger-subtle text-danger ms-1">-5%</span></div>
                        <div class="text-muted text-decoration-line-through small">30.000 ₫</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Blog Articles Section -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-uppercase m-0 border-start border-4 border-primary ps-2">Sách Hay Mỗi Ngày</h4>
        <a href="#" class="text-primary text-decoration-none fw-bold small">Xem tất cả <i class="bi bi-chevron-right"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <img src="/images/news/hoc-tieng-trung.jpg" class="card-img-top" alt="Tiếng Trung">
                <div class="card-body">
                    <small class="text-muted">22/07/2026</small>
                    <h6 class="card-title fw-bold mt-1">Lộ trình học tiếng Trung bài bản từ số 0 cho người mới bắt đầu</h6>
                    <p class="card-text text-muted small text-truncate-3">Bạn đang muốn bắt đầu hành trình chinh phục tiếng Trung nhưng đứng giữa mê hồn trận...</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <img src="/images/news/doi-gio-hu.jpg" class="card-img-top" alt="Đồi Gió Hú">
                <div class="card-body">
                    <small class="text-muted">23/06/2026</small>
                    <h6 class="card-title fw-bold mt-1">Những trích dẫn trong "Đồi gió hú" khiến độc giả tan nát cõi lòng</h6>
                    <p class="card-text text-muted small text-truncate-3">Xuất bản lần đầu năm 1847 và cũng là tiểu thuyết duy nhất của nữ nhà văn Emily Brontë...</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <img src="/images/news/ca-phe-nguoi.jpg" class="card-img-top" alt="Khi Tách Cà Phê Còn Chưa Nguội">
                <div class="card-body">
                    <small class="text-muted">22/04/2026</small>
                    <h6 class="card-title fw-bold mt-1">Thứ tự đọc trọn bộ series "Khi Tách Cà Phê Còn Chưa Nguội"</h6>
                    <p class="card-text text-muted small text-truncate-3">Nếu có thể quay về quá khứ, liệu bạn có kịp trở lại hiện tại trước khi tách cà phê nguội lạnh?...</p>
                </div>
            </div>
        </div>
    </div>
</div>